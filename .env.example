# Хранилище. По умолчанию локальный SQLite.
# Для облака: postgresql://user:pass@host/db (Neon / Supabase free tier)
TRENDRADAR_DB=sqlite:///./data/trendradar.db

# Ключи НЕ НУЖНЫ. Все пять источников работают без регистрации.
# Эти переменные зарезервированы на будущее:
YOUTUBE_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YouTube Data API v3. Optional: RSS collection works without it.
# Costs 100 units per search, 1 per 50 video stats. Quota 10k/day.
YT_API_KEY=
